    "db:deploy": "prisma migrate deploy",
    "start:worker": "bun run src/lib/worker.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "bun run prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.5",
