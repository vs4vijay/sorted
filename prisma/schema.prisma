generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  @@map("items")
}

model Job {
  id             String    @id
  taskIdentifier String    @map("task_identifier")
  payload        Json      @default("{}")
  status         String    @default("pending")
  priority       Int       @default(0)
  runAt          DateTime  @map("run_at")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(25) @map("max_attempts")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  completedAt    DateTime? @map("completed_at")
  key            String?   @unique
  queue          String?

  @@index([status, runAt])
  @@index([priority, runAt])
  @@map("jobs")
}

enum OrganizationStatus {
  active
  suspended
  archived
}

enum OrganizationRole {
  admin
  recruiter
  hiring_manager
  technical_reviewer
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model User {
  id           String               @id
  email        String               @unique
  name         String
  passwordHash String?              @map("password_hash")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @default(now()) @map("updated_at")
  memberships  OrganizationMember[]
  invitations  Invitation[]         @relation("InvitationCreator")
  sessions     Session[]

  @@map("users")
}

model Organization {
  id            String               @id
  name          String
  slug          String               @unique
  status        OrganizationStatus   @default(active)
  timezone      String               @default("Asia/Kolkata")
  defaultLocale String               @default("en-IN") @map("default_locale")
  retentionDays Int                  @default(730) @map("retention_days")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @default(now()) @map("updated_at")
  memberships   OrganizationMember[]
  invitations   Invitation[]
  auditEvents   AuditEvent[]
  positions     Position[]
  candidates    Candidate[]
  candidateSources CandidateSource[]
  candidateDocuments CandidateDocument[]
  ingestionRuns IngestionRun[]

  @@map("organizations")
}

enum PositionStatus {
  draft
  rubric_review
  screening
  closed
}
enum CriterionClassification {
  must_have
  preferred
  logistics
  informational
}
enum RubricStatus {
  draft
  approved
  superseded
}

model Position {
  id String @id
  organizationId String @map("organization_id")
  title String
  status PositionStatus @default(draft)
  employmentType String @map("employment_type")
  location String?
  workplacePreference String? @map("workplace_preference")
  compensationMin Int? @map("compensation_min")
  compensationMax Int? @map("compensation_max")
  minimumExperience Int? @map("minimum_experience")
  preferredExperience Int? @map("preferred_experience")
  noticePeriodDays Int? @map("notice_period_days")
  shiftTravel String? @map("shift_travel")
  workAuthorization String? @map("work_authorization")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobDescriptions JobDescription[]
  rubrics EvaluationRubric[]
  panel HiringPanelMember[]
  @@index([organizationId, createdAt])
  @@map("positions")
}

model JobDescription {
  id String @id
  organizationId String @map("organization_id")
  positionId String @map("position_id")
  version Int
  sourceType String @map("source_type")
  rawText String? @map("raw_text")
  structuredData Json @default("{}") @map("structured_data")
  extractionMode String @map("extraction_mode")
  providerExecutionId String? @map("provider_execution_id")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  @@unique([organizationId, positionId, version])
  @@map("job_descriptions")
}

model EvaluationRubric {
  id String @id
  organizationId String @map("organization_id")
  positionId String @map("position_id")
  version Int
  status RubricStatus @default(draft)
  approvedById String? @map("approved_by_id")
  approvedAt DateTime? @map("approved_at")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  criteria RubricCriterion[]
  @@unique([organizationId, positionId, version])
  @@map("evaluation_rubrics")
}

model RubricCriterion {
  id String @id
  organizationId String @map("organization_id")
  rubricId String @map("rubric_id")
  name String
  description String
  criterionType String @map("criterion_type")
  classification CriterionClassification
  weight Int
  evidenceExpectations String @map("evidence_expectations")
  displayOrder Int @map("display_order")
  rubric EvaluationRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  @@index([organizationId, rubricId, displayOrder])
  @@map("rubric_criteria")
}

model HiringPanelMember {
  id String @id
  organizationId String @map("organization_id")
  positionId String @map("position_id")
  organizationMemberId String @map("organization_member_id")
  panelRole String @map("panel_role")
  createdAt DateTime @default(now()) @map("created_at")
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  @@unique([organizationId, positionId, organizationMemberId])
  @@map("hiring_panel_members")
}

model ProviderExecution {
  id String @id
  organizationId String @map("organization_id")
  provider String
  operation String
  model String
  promptVersion String @map("prompt_version")
  schemaVersion String @map("schema_version")
  providerRequestId String? @map("provider_request_id")
  latencyMs Int? @map("latency_ms")
  status String
  normalizedError Json? @map("normalized_error")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, createdAt])
  @@map("provider_executions")
}

model VoiceNote {
  id String @id
  organizationId String @map("organization_id")
  positionId String @map("position_id")
  purpose String
  languageCode String @map("language_code")
  consentRecordedById String @map("consent_recorded_by_id")
  consentRecordedAt DateTime @map("consent_recorded_at")
  storageKey String? @map("storage_key")
  mediaType String @map("media_type")
  byteSize Int @map("byte_size")
  checksum String
  status String
  transcript String?
  transcriptData Json? @map("transcript_data")
  providerExecutionId String? @map("provider_execution_id")
  reviewedTranscript String? @map("reviewed_transcript")
  reviewedById String? @map("reviewed_by_id")
  reviewedAt DateTime? @map("reviewed_at")
  sourceDeletedAt DateTime? @map("source_deleted_at")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([organizationId, positionId, createdAt])
  @@map("voice_notes")
}

enum DocumentProcessingStatus {
  uploaded
  scanning
  extracting
  parsed
  needs_review
  failed
}
enum DuplicateClassification {
  same_candidate
  possible_duplicate
  distinct
}

model Candidate {
  id String @id
  organizationId String @map("organization_id")
  displayName String @map("display_name")
  headline String?
  location String?
  profileStatus String @default("unreviewed") @map("profile_status")
  mergedIntoId String? @map("merged_into_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sources CandidateSource[]
  identities CandidateIdentity[]
  links ExternalProfileLink[]
  applications Application[]
  evaluations CandidateEvaluation[]
  @@index([organizationId, createdAt])
  @@map("candidates")
}

enum EvaluationState {
  queued
  evaluated
  stale
  failed
}
enum EvaluationRecommendation {
  strong_review
  review
  needs_information
  low_match
}
enum CriterionRating {
  strong
  meets
  partial
  missing
  contradicted
}

model CandidateEvaluation {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  positionId String @map("position_id")
  rubricId String @map("rubric_id")
  rubricVersion Int @map("rubric_version")
  state EvaluationState
  roleFit Int? @map("role_fit")
  evidenceConfidence Int? @map("evidence_confidence")
  recommendation EvaluationRecommendation?
  evidenceSnapshot Json @map("evidence_snapshot")
  providerExecutionId String? @map("provider_execution_id")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  criteria CriterionEvaluation[]
  @@index([organizationId, positionId, createdAt])
  @@index([organizationId, candidateId, createdAt])
  @@map("candidate_evaluations")
}

model CriterionEvaluation {
  id String @id
  organizationId String @map("organization_id")
  candidateEvaluationId String @map("candidate_evaluation_id")
  criterionId String @map("criterion_id")
  rating CriterionRating
  score Int
  evidenceConfidence Int @map("evidence_confidence")
  reasoning String
  evidenceClaimIds Json @map("evidence_claim_ids")
  gaps Json
  createdAt DateTime @default(now()) @map("created_at")
  evaluation CandidateEvaluation @relation(fields: [candidateEvaluationId], references: [id], onDelete: Cascade)
  @@index([organizationId, candidateEvaluationId])
  @@map("criterion_evaluations")
}

enum PanelReviewState {
  not_started
  in_review
  submitted
  changes_requested
}

enum ReviewerRecommendation {
  shortlist
  hold
  needs_information
  do_not_advance
}

model ReviewAssignment {
  id String @id
  organizationId String @map("organization_id")
  candidateEvaluationId String @map("candidate_evaluation_id")
  reviewerMemberId String @map("reviewer_member_id")
  state PanelReviewState @default(not_started)
  assignedById String @map("assigned_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@unique([organizationId, candidateEvaluationId, reviewerMemberId])
  @@index([organizationId, reviewerMemberId, state])
  @@map("review_assignments")
}

model PanelReview {
  id String @id
  organizationId String @map("organization_id")
  assignmentId String @map("assignment_id")
  candidateEvaluationId String @map("candidate_evaluation_id")
  reviewerMemberId String @map("reviewer_member_id")
  recommendation ReviewerRecommendation
  summary String
  criterionFeedback Json @map("criterion_feedback")
  submittedAt DateTime @default(now()) @map("submitted_at")
  @@index([organizationId, candidateEvaluationId, submittedAt])
  @@map("panel_reviews")
}

model ReviewComment {
  id String @id
  organizationId String @map("organization_id")
  candidateEvaluationId String @map("candidate_evaluation_id")
  criterionId String? @map("criterion_id")
  evidenceClaimId String? @map("evidence_claim_id")
  authorMemberId String @map("author_member_id")
  body String
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, candidateEvaluationId, createdAt])
  @@map("review_comments")
}

model ShortlistDecision {
  id String @id
  organizationId String @map("organization_id")
  candidateEvaluationId String @map("candidate_evaluation_id")
  candidateId String @map("candidate_id")
  positionId String @map("position_id")
  decision String
  rationale String
  decidedById String @map("decided_by_id")
  decidedAt DateTime @default(now()) @map("decided_at")
  @@index([organizationId, candidateEvaluationId, decidedAt])
  @@map("shortlist_decisions")
}

model DecisionEvent {
  id String @id
  organizationId String @map("organization_id")
  shortlistDecisionId String @map("shortlist_decision_id")
  eventType String @map("event_type")
  actorUserId String @map("actor_user_id")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, shortlistDecisionId, createdAt])
  @@map("decision_events")
}

model Notification {
  id String @id
  organizationId String @map("organization_id")
  recipientMemberId String @map("recipient_member_id")
  kind String
  subjectType String @map("subject_type")
  subjectId String @map("subject_id")
  body String
  readAt DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, recipientMemberId, createdAt])
  @@map("notifications")
}

model IngestionRun {
  id String @id
  organizationId String @map("organization_id")
  positionId String? @map("position_id")
  sourceType String @map("source_type")
  status String
  totalCount Int @map("total_count")
  completedCount Int @default(0) @map("completed_count")
  failedCount Int @default(0) @map("failed_count")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sources CandidateSource[]
  @@index([organizationId, createdAt])
  @@map("ingestion_runs")
}

model CandidateSource {
  id String @id
  organizationId String @map("organization_id")
  candidateId String? @map("candidate_id")
  ingestionRunId String @map("ingestion_run_id")
  sourceType String @map("source_type")
  permissionMethod String @map("permission_method")
  status DocumentProcessingStatus @default(uploaded)
  sourceLabel String @map("source_label")
  importedById String @map("imported_by_id")
  importedAt DateTime @default(now()) @map("imported_at")
  warnings Json @default("[]")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate Candidate? @relation(fields: [candidateId], references: [id])
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  document CandidateDocument?
  @@index([organizationId, candidateId])
  @@map("candidate_sources")
}

model CandidateDocument {
  id String @id
  organizationId String @map("organization_id")
  sourceId String @unique @map("source_id")
  storageKey String @map("storage_key")
  originalFilename String @map("original_filename")
  mediaType String @map("media_type")
  byteSize Int @map("byte_size")
  checksum String
  pageCount Int? @map("page_count")
  malwareScanStatus String @map("malware_scan_status")
  pdfType String? @map("pdf_type")
  parsedTextMarkdown String? @map("parsed_text_markdown")
  pagesNeedingOcr Json @default("[]") @map("pages_needing_ocr")
  extractor String?
  extractorVersion String? @map("extractor_version")
  extractionConfidence Float? @map("extraction_confidence")
  processingTimeMs Int? @map("processing_time_ms")
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source CandidateSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@unique([organizationId, checksum])
  @@map("candidate_documents")
}

model CandidateIdentity {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  identityType String @map("identity_type")
  normalizedValue String? @map("normalized_value")
  valueFingerprint String @map("value_fingerprint")
  rawValueEncrypted String? @map("raw_value_encrypted")
  verified Boolean @default(false)
  sourceId String @map("source_id")
  createdAt DateTime @default(now()) @map("created_at")
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@unique([organizationId, identityType, valueFingerprint])
  @@index([organizationId, candidateId])
  @@map("candidate_identities")
}

model ExternalProfileLink {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  sourceId String @map("source_id")
  provider String
  profileUrl String @map("profile_url")
  externalId String? @map("external_id")
  retrievalMethod String @map("retrieval_method")
  createdAt DateTime @default(now()) @map("created_at")
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@index([organizationId, candidateId])
  @@map("external_profile_links")
}

model Application {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  positionId String @map("position_id")
  stage String @default("applied")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@unique([organizationId, candidateId, positionId])
  @@index([organizationId, positionId])
  @@map("applications")
}

model DuplicateReview {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  possibleCandidateId String @map("possible_candidate_id")
  classification DuplicateClassification
  confidence Float
  signals Json
  status String @default("pending")
  resolvedById String? @map("resolved_by_id")
  resolvedAt DateTime? @map("resolved_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, status])
  @@map("duplicate_reviews")
}

model EvidenceClaim {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  sourceId String @map("source_id")
  claimType String @map("claim_type")
  label String
  claimValue String @map("claim_value")
  claimStatus String @map("claim_status")
  pageNumber Int? @map("page_number")
  sectionLabel String? @map("section_label")
  excerpt String?
  extractorVersion String @map("extractor_version")
  confidence Float
  createdByType String @map("created_by_type")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, candidateId, createdAt])
  @@map("evidence_claims")
}

model EvidenceClaimCorrection {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  claimId String @map("claim_id")
  action String
  correctedValue String? @map("corrected_value")
  reason String
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, claimId, createdAt])
  @@map("evidence_claim_corrections")
}

model MessageTemplate {
  id String @id
  organizationId String @map("organization_id")
  name String
  purpose String
  subject String
  body String
  version Int @default(1)
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, purpose])
  @@map("message_templates")
}

model OutreachThread {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  applicationId String? @map("application_id")
  positionId String? @map("position_id")
  purpose String
  status String @default("draft")
  requestedFields Json @default("[]") @map("requested_fields")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([organizationId, candidateId, updatedAt])
  @@map("outreach_threads")
}

model OutreachMessage {
  id String @id
  organizationId String @map("organization_id")
  threadId String @map("thread_id")
  direction String
  subject String
  body String
  status String @default("draft")
  approvalVersion Int @default(0) @map("approval_version")
  approvedById String? @map("approved_by_id")
  approvedAt DateTime? @map("approved_at")
  provider String?
  providerMessageId String? @map("provider_message_id")
  idempotencyKey String @unique @map("idempotency_key")
  sentAt DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([organizationId, threadId, createdAt])
  @@map("outreach_messages")
}

model CandidateResponse {
  id String @id
  organizationId String @map("organization_id")
  threadId String @map("thread_id")
  providerEventId String @map("provider_event_id")
  body String
  parsedSuggestions Json @default("[]") @map("parsed_suggestions")
  receivedAt DateTime @default(now()) @map("received_at")
  @@unique([organizationId, providerEventId])
  @@index([organizationId, threadId, receivedAt])
  @@map("candidate_responses")
}

model DeliveryEvent {
  id String @id
  organizationId String @map("organization_id")
  threadId String @map("thread_id")
  messageId String? @map("message_id")
  providerEventId String @map("provider_event_id")
  eventType String @map("event_type")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([organizationId, providerEventId])
  @@index([organizationId, threadId, createdAt])
  @@map("delivery_events")
}

model OptOut {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  threadId String? @map("thread_id")
  channel String
  reason String?
  recordedAt DateTime @default(now()) @map("recorded_at")
  @@unique([organizationId, candidateId, channel])
  @@map("opt_outs")
}

model CandidateCommunicationPreference {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  channel String
  languageCode String @map("language_code")
  status String
  source String
  recordedById String @map("recorded_by_id")
  recordedAt DateTime @default(now()) @map("recorded_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  @@unique([organizationId, candidateId, channel, languageCode])
  @@index([organizationId, candidateId, status])
  @@map("candidate_communication_preferences")
}

model CandidateAudioAsset {
  id String @id
  organizationId String @map("organization_id")
  candidateId String @map("candidate_id")
  messageId String @map("message_id")
  textHash String @map("text_hash")
  textApprovalVersion Int @map("text_approval_version")
  languageCode String @map("language_code")
  voice String
  status String @default("generating")
  provider String?
  model String?
  schemaVersion String @map("schema_version")
  providerRequestId String? @map("provider_request_id")
  storageKey String? @map("storage_key")
  mediaType String? @map("media_type")
  byteSize Int? @map("byte_size")
  normalizedError String? @map("normalized_error")
  generatedById String @map("generated_by_id")
  generatedAt DateTime? @map("generated_at")
  expiresAt DateTime @map("expires_at")
  invalidatedAt DateTime? @map("invalidated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([organizationId, messageId, createdAt])
  @@index([organizationId, candidateId, status])
  @@map("candidate_audio_assets")
}

model OutreachSequence {
  id String @id
  organizationId String @map("organization_id")
  name String
  purpose String
  status String @default("draft")
  businessTimezone String @default("Asia/Kolkata") @map("business_timezone")
  maxAttempts Int @default(1) @map("max_attempts")
  createdById String @map("created_by_id")
  approvedById String? @map("approved_by_id")
  approvedAt DateTime? @map("approved_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, status])
  @@map("outreach_sequences")
}

model OutreachStep {
  id String @id
  organizationId String @map("organization_id")
  sequenceId String @map("sequence_id")
  stepOrder Int @map("step_order")
  delayBusinessDays Int @map("delay_business_days")
  subject String
  body String
  status String @default("draft")
  @@unique([organizationId, sequenceId, stepOrder])
  @@map("outreach_steps")
}

model SequenceEnrollment {
  id String @id
  organizationId String @map("organization_id")
  sequenceId String @map("sequence_id")
  threadId String @map("thread_id")
  status String @default("scheduled")
  currentStep Int @default(1) @map("current_step")
  attempts Int @default(0)
  nextRunAt DateTime? @map("next_run_at")
  stopReason String? @map("stop_reason")
  stoppedAt DateTime? @map("stopped_at")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([organizationId, status, nextRunAt])
  @@map("sequence_enrollments")
}

model PipelineStageTransition {
  id String @id
  organizationId String @map("organization_id")
  applicationId String @map("application_id")
  fromStage String @map("from_stage")
  toStage String @map("to_stage")
  actorUserId String @map("actor_user_id")
  rationale String
  snapshotId String? @map("snapshot_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, applicationId, createdAt])
  @@map("pipeline_stage_transitions")
}

model PipelineHandoffSnapshot {
  id String @id
  organizationId String @map("organization_id")
  applicationId String @map("application_id")
  candidateId String @map("candidate_id")
  positionId String @map("position_id")
  shortlistDecisionId String @map("shortlist_decision_id")
  candidateEvaluationId String @map("candidate_evaluation_id")
  rubricId String @map("rubric_id")
  rubricVersion Int @map("rubric_version")
  evidenceSnapshot Json @map("evidence_snapshot")
  responseThreadId String @map("response_thread_id")
  rationale String
  advancedById String @map("advanced_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, applicationId, createdAt])
  @@map("pipeline_handoff_snapshots")
}

model OrganizationMember {
  id             String           @id
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String           @id
  organizationId String           @map("organization_id")
  email          String
  role           OrganizationRole
  status         InvitationStatus @default(pending)
  tokenHash      String           @unique @map("token_hash")
  invitedById    String           @map("invited_by_id")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationCreator", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@map("invitations")
}

model Session {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id             String       @id
  organizationId String       @map("organization_id")
  actorUserId    String?      @map("actor_user_id")
  action         String
  subjectType    String       @map("subject_type")
  subjectId      String       @map("subject_id")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, subjectType, subjectId])
  @@map("audit_events")
}
