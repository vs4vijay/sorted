generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("items")
}

model Job {
  id             String    @id
  taskIdentifier String    @map("task_identifier")
  payload        Json      @default("{}")
  status         String    @default("pending")
  priority       Int       @default(0)
  runAt          DateTime  @map("run_at")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(25) @map("max_attempts")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  completedAt    DateTime? @map("completed_at")
  key            String?   @unique
  queue          String?

  @@index([status, runAt])
  @@index([priority, runAt])
  @@map("jobs")
}

enum OrganizationStatus {
  active
  suspended
  archived
}

enum OrganizationRole {
  admin
  recruiter
  hiring_manager
  technical_reviewer
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model User {
  id           String               @id
  email        String               @unique
  name         String
  passwordHash String?              @map("password_hash")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @default(now()) @map("updated_at")
  memberships  OrganizationMember[]
  invitations  Invitation[]         @relation("InvitationCreator")
  sessions     Session[]

  @@map("users")
}

model Organization {
  id            String               @id
  name          String
  slug          String               @unique
  status        OrganizationStatus   @default(active)
  timezone      String               @default("Asia/Kolkata")
  defaultLocale String               @default("en-IN") @map("default_locale")
  retentionDays Int                  @default(730) @map("retention_days")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @default(now()) @map("updated_at")
  memberships   OrganizationMember[]
  invitations   Invitation[]
  auditEvents   AuditEvent[]
  positions     Position[]

  @@map("organizations")
}

enum PositionStatus {
  draft
  rubric_review
  screening
  closed
}
enum CriterionClassification {
  must_have
  preferred
  logistics
  informational
}
enum RubricStatus {
  draft
  approved
  superseded
}

model Position {
  id String @id
  organizationId String @map("organization_id")
  title String
  status PositionStatus @default(draft)
  employmentType String @map("employment_type")
  location String?
  workplacePreference String? @map("workplace_preference")
  compensationMin Int? @map("compensation_min")
  compensationMax Int? @map("compensation_max")
  minimumExperience Int? @map("minimum_experience")
  preferredExperience Int? @map("preferred_experience")
  noticePeriodDays Int? @map("notice_period_days")
  shiftTravel String? @map("shift_travel")
  workAuthorization String? @map("work_authorization")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobDescriptions JobDescription[]
  rubrics EvaluationRubric[]
  panel HiringPanelMember[]
  @@index([organizationId, createdAt])
  @@map("positions")
}

model JobDescription {
  id String @id
  organizationId String @map("organization_id")
  positionId String @map("position_id")
  version Int
  sourceType String @map("source_type")
  rawText String? @map("raw_text")
  structuredData Json @default("{}") @map("structured_data")
  extractionMode String @map("extraction_mode")
  providerExecutionId String? @map("provider_execution_id")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  @@unique([organizationId, positionId, version])
  @@map("job_descriptions")
}

model EvaluationRubric {
  id String @id
  organizationId String @map("organization_id")
  positionId String @map("position_id")
  version Int
  status RubricStatus @default(draft)
  approvedById String? @map("approved_by_id")
  approvedAt DateTime? @map("approved_at")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  criteria RubricCriterion[]
  @@unique([organizationId, positionId, version])
  @@map("evaluation_rubrics")
}

model RubricCriterion {
  id String @id
  organizationId String @map("organization_id")
  rubricId String @map("rubric_id")
  name String
  description String
  criterionType String @map("criterion_type")
  classification CriterionClassification
  weight Int
  evidenceExpectations String @map("evidence_expectations")
  displayOrder Int @map("display_order")
  rubric EvaluationRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  @@index([organizationId, rubricId, displayOrder])
  @@map("rubric_criteria")
}

model HiringPanelMember {
  id String @id
  organizationId String @map("organization_id")
  positionId String @map("position_id")
  organizationMemberId String @map("organization_member_id")
  panelRole String @map("panel_role")
  createdAt DateTime @default(now()) @map("created_at")
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  @@unique([organizationId, positionId, organizationMemberId])
  @@map("hiring_panel_members")
}

model ProviderExecution {
  id String @id
  organizationId String @map("organization_id")
  provider String
  operation String
  model String
  promptVersion String @map("prompt_version")
  schemaVersion String @map("schema_version")
  providerRequestId String? @map("provider_request_id")
  latencyMs Int? @map("latency_ms")
  status String
  normalizedError Json? @map("normalized_error")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, createdAt])
  @@map("provider_executions")
}

model OrganizationMember {
  id             String           @id
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String           @id
  organizationId String           @map("organization_id")
  email          String
  role           OrganizationRole
  status         InvitationStatus @default(pending)
  tokenHash      String           @unique @map("token_hash")
  invitedById    String           @map("invited_by_id")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationCreator", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@map("invitations")
}

model Session {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id             String       @id
  organizationId String       @map("organization_id")
  actorUserId    String?      @map("actor_user_id")
  action         String
  subjectType    String       @map("subject_type")
  subjectId      String       @map("subject_id")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, subjectType, subjectId])
  @@map("audit_events")
}
