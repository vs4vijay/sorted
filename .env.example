# Database Configuration
# For local development with PGlite, use:
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:7070"

# For production PostgreSQL, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Environment
NODE_ENV="development"

# Server-only. Never expose this using a NEXT_PUBLIC_ prefix.
SARVAM_API_KEY="replace-with-your-sarvam-api-key"
# Email delivery — server only. Omit either value for honest simulated delivery.
EMAIL_PROVIDER_API_KEY="replace-with-your-email-provider-api-key"
EMAIL_FROM_ADDRESS="verified-sender@example.com"
EMAIL_WEBHOOK_SECRET="replace-with-your-webhook-secret"
APP_ENV="development"
LOG_LEVEL="info"
