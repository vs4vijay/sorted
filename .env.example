# Database Configuration
# Prisma migrate requires postgresql:// or postgres:// (file: PGlite is rejected).
# Local Postgres (recommended for migrations / full stack):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sorted"
APP_URL="http://localhost:7070"

# PGlite-only mode (API + UI). Do NOT use with bun run db:migrate — use bun run db:init:
# DATABASE_URL="file:./dev.db"

# Environment
NODE_ENV="development"

# Server-only. Never expose this using a NEXT_PUBLIC_ prefix.
SARVAM_API_KEY="replace-with-your-sarvam-api-key"
APP_ENV="development"
LOG_LEVEL="info"
