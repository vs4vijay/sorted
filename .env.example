# Database Configuration
# `bun run dev` starts the local single-owner PGlite socket server automatically.
DATABASE_URL="postgresql://127.0.0.1:5433/sorted"
PGLITE_PORT="5433"
PGLITE_DATA_DIR="./dev.db"
APP_URL="http://localhost:7070"

# For production PostgreSQL, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Environment
NODE_ENV="development"

# Server-only. Never expose this using a NEXT_PUBLIC_ prefix.
SARVAM_API_KEY="replace-with-your-sarvam-api-key"
SARVAM_ENABLED="false"
# Email delivery — server only. Omit either value for honest simulated delivery.
EMAIL_PROVIDER_API_KEY="replace-with-your-email-provider-api-key"
EMAIL_FROM_ADDRESS="verified-sender@example.com"
EMAIL_WEBHOOK_SECRET="replace-with-your-webhook-secret"
EMAIL_DELIVERY_ENABLED="false"
# Production malware-scanner HTTP endpoint. It receives multipart field `file`
# and returns { verdict, engineVersion, threatName?, requestId? }.
MALWARE_SCANNER_URL="https://scanner.example.com/v1/scan"
MALWARE_SCANNER_TOKEN="replace-with-your-scanner-token"
MALWARE_SCANNER_ENABLED="false"
APP_ENV="development"
LOG_LEVEL="info"

# Local development only. When true, Sorted provisions a synthetic admin
# workspace and skips sign-up/sign-in. The server rejects this in preview or production.
LOCAL_AUTH_BYPASS="false"
